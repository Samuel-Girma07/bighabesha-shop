# ===================================================
# Bighabesha Shop Configuration
# ===================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Admin Telegram User IDs (comma-separated, exactly 2 for production)
ADMIN_IDS=123456789,987654321

# Wallet Pay Settings
# Set to 'mock' for local development & testing, 'live' for production
WALLET_PAY_MODE=mock
WALLET_PAY_API_KEY=

# Database Configuration
DATABASE_PATH=./data/shop.db

# Server & Mini App Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
WEBAPP_URL=https://shop.bighabesha.com

# Support Handle
SUPPORT_USERNAME=Vweah
