# ===================================================
# Bighabesha Shop Configuration
# ===================================================
# PRODUCTION BOOT REQUIREMENTS (fail-closed — the app refuses to start if any
# of these are missing/invalid when NODE_ENV=production):
#   - ADMIN_PASSWORD must be set (min 8 chars). There is NO default.
#   - WALLET_PAY_MODE must be explicitly "live" (mock auto-confirms payments).
#   - WALLET_PAY_API_KEY must be set when mode is live.
# ===================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Admin Telegram User IDs (comma-separated, exactly 2 for production)
ADMIN_IDS=123456789,987654321

# Master password for the web admin dashboard (/admin).
# REQUIRED in production. In development, leaving this empty disables the
# dashboard login entirely (fail-closed) instead of falling back to a default.
ADMIN_PASSWORD=

# ===================================================
# Active Payment Rails
# ===================================================
# The active customer payment rails in Bighabesha Shop are strictly:
#   - telebirr  : Telebirr Mobile Money (manual photo receipt upload & admin review)
#   - cbe       : Commercial Bank of Ethiopia (manual photo receipt upload & admin review)
#   - abyssinia : Bank of Abyssinia (manual photo receipt upload & admin review)
#
# Admin receiving account details (account numbers and account holder names)
# are managed dynamically in the Admin Dashboard (/admin) or the settings database table:
#   - telebirr_account, telebirr_name
#   - cbe_account, cbe_name
#   - abyssinia_account, abyssinia_name
#
# NOTE: Legacy rails (wallet_pay, chapa, ton_connect) are deprecated/discontinued.
# WALLET_PAY_MODE and WALLET_PAY_API_KEY below are maintained for backward-compatibility
# validation invariants.
# ===================================================

# Wallet Pay Settings
# Set to 'mock' for local development & testing, 'live' for production.
# Production + mock is a boot error by design.
WALLET_PAY_MODE=mock
WALLET_PAY_API_KEY=

# Database & Persistent Storage Configuration
# For local development, defaults to ./data/shop.db and ./data/receipts.
# On cloud platforms with persistent disks (e.g. Render.com, Fly.io, Railway):
# Set DATA_DIR to the mount path of your persistent disk (e.g. /var/data).
# The bot will automatically store shop.db and receipts/ inside that directory:
#   - Database : <DATA_DIR>/shop.db
#   - Receipts : <DATA_DIR>/receipts/
# You can also override them individually with DATABASE_PATH and RECEIPTS_DIR.
# DATA_DIR=/var/data
DATABASE_PATH=./data/shop.db
# RECEIPTS_DIR=./data/receipts

# ===================================================
# Backblaze B2 / S3 Continuous Cloud Replication (Litestream)
# ===================================================
# Enables 100% free persistent cloud database and receipt storage on ephemeral
# hosting platforms (like Render Free tier).
# Requires NO credit card: Create a free bucket and application key on Backblaze B2.
# B2_BUCKET=my-bighabesha-backup
# B2_ENDPOINT=s3.us-west-004.backblazeb2.com
# B2_KEY_ID=004xxxxxxxxxxxx0000000001
# B2_APPLICATION_KEY=K004xxxxxxxxxxxxxxxxxxxxxxx
# B2_REGION=us-west-004

# Server & Mini App Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
WEBAPP_URL=https://shop.bighabesha.com

# Reverse proxy / tunnel configuration.
# In production an EMPTY value auto-defaults to "loopback" (correct behind
# cloudflared/nginx-on-box) with a boot warning — this prevents every client
# from sharing the proxy's loopback IP, which would throttle all users
# collectively through one rate-limit bucket. Set explicitly to override
# ("1", "true", "false", "loopback", "10.0.0.0/8", ...). Empty = disabled (local dev).
TRUST_PROXY=

# Extra CORS origins allowed to call the API, comma-separated.
# WEBAPP_URL is always allowed automatically.
CORS_ORIGINS=

# Support Handle
SUPPORT_USERNAME=Vweah

# ---- v1.2.0 B2B Reseller Fulfillment (Telegram Premium) ----
# Delivery provider for automated Telegram Premium activations.
# Supported providers:
#   mock    - Dev/test only; auto-succeeds immediately with a synthetic transaction ID.
#             (Default for local development & automated test suites)
#   gramix  - Gramix B2B API (GRAMIX_API_URL defaults to https://api.gramix.io/v1)
#   istar   - iStar B2B API (ISTAR_API_URL defaults to https://istar.io/api/v2)
#   both    - Dual-provider cascading failover (Gramix primary -> iStar fallback; concurrent balance check)
#   cascade - Alias for 'both'
#   generic - Custom webhook endpoint; RESELLER_API_URL is REQUIRED (POST {fulfill|balance})
#
# Instructions for switching to live providers:
#   - Dual-provider cascading mode (recommended for production):
#       RESELLER_PROVIDER=both
#       GRAMIX_API_KEY=<your-gramix-api-key>
#       ISTAR_API_KEY=<your-istar-api-key>
#   - Single provider Gramix: set RESELLER_PROVIDER=gramix and supply GRAMIX_API_KEY (or RESELLER_API_KEY).
#   - Single provider iStar:  set RESELLER_PROVIDER=istar and supply ISTAR_API_KEY (or RESELLER_API_KEY).
#   - When RESELLER_PROVIDER is unset/empty, Premium orders fall back to the manual fulfillment queue
#     (orders wait in 'pending_fulfillment' for admin fulfillment by hand).
RESELLER_PROVIDER=mock
# Dedicated provider API keys — sent as Authorization: Bearer <key>. Never logged in cleartext.
GRAMIX_API_KEY=
ISTAR_API_KEY=
# Shared legacy API key (fallback for single-provider setups)
RESELLER_API_KEY=
# Provider base URL overrides (optional for gramix/istar, REQUIRED for generic)
GRAMIX_API_URL=
ISTAR_API_URL=
RESELLER_API_URL=
# When the provider float drops below this USDT amount, admins are alerted.
RESELLER_LOW_BALANCE_ALERT_USDT=50

# ---- Legacy / Deprecated Integrations (all optional; self-disabled) ----
# Active customer rails are telebirr, cbe, and abyssinia. The following are legacy integrations:
# In-app support bridge: forum-enabled Telegram group id (e.g. -1004567890123)
SUPPORT_GROUP_ID=
# Chapa gateway secret key (https://chapa.co) — legacy rail (discontinued)
CHAPA_SECRET_KEY=
# TON treasury wallet address — legacy non-custodial rail (discontinued)
TON_TREASURY_ADDRESS=

# ===================================================
# Ethiopian Bank Receipt Verification Engine (v1.3.0)
# ===================================================
# Automated verification engine for CBE, Telebirr, and Bank of Abyssinia receipts.
# Integrates multi-pass OCR, QR matrix decoding, PDF streaming, bank portal scraping,
# and a 4-Pillar Security Gate (Anti-Replay, Beneficiary Whitelist, Amount Matching,
# and Recency Bounds).

# Enable or disable automated external bank portal verification.
# 1 = Automated verification active (real-time portal query and instant order fulfillment)
# 0 = Verification engine bypassed; all submissions route to manual admin review queue
RECEIPT_AUTO_VERIFY_ENABLED=1

# Commercial Bank of Ethiopia (CBE) Confirmation Portal Port
# CBE operates its official public transaction verification portal on non-standard Port 100:
#   https://apps.cbe.com.et:100/?id=<reference>
# Set to '100' for standard live verification, or '443' if fronted by an internal SNI reverse proxy.
# Default: 100
RECEIPT_CBE_PORT=100

# Ethio Telecom Telebirr Residential / In-Country Egress Proxy
# Telebirr confirmation portal (transactioninfo.ethiotelecom.et) actively geoblocks foreign IP
# addresses (HTTP 403 Forbidden / Cloudflare geo-fence) when queried from outside Ethiopia.
# Provide a residential HTTP/HTTPS or SOCKS5 proxy terminating inside Ethiopia (AS24757).
# Format: http://user:pass@host:port OR socks5://user:pass@host:port
# Default: empty (direct egress, suitable if hosting inside Ethiopia or testing)
TELEBIRR_PROXY_URL=
# Backward compatibility alias for TELEBIRR_PROXY_URL
ETHIOPIA_PROXY_URL=

# Circuit Breaker Protection against Upstream Flapping
# Automatically trips to OPEN if upstream bank web portals fail or time out repeatedly,
# preventing worker thread exhaustion and cascading delays.
# RECEIPT_CIRCUIT_BREAKER_FAILURES: Consecutive failed attempts before circuit trips OPEN (default: 3)
# RECEIPT_CIRCUIT_BREAKER_COOLDOWN_MS: Cooldown window before HALF-OPEN probe (default: 60000 = 60s)
RECEIPT_CIRCUIT_BREAKER_FAILURES=3
RECEIPT_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# 4-Pillar Security Gate: Recency Window Tolerances
# Rejects payment receipts outside the acceptable temporal distance from order creation.
# RECEIPT_RECENCY_BEFORE_MINS: Maximum allowable minutes a slip timestamp can precede order creation (default: 120)
# RECEIPT_RECENCY_AFTER_MINS: Maximum allowable minutes a slip timestamp can follow order creation (default: 120)
RECEIPT_RECENCY_BEFORE_MINS=120
RECEIPT_RECENCY_AFTER_MINS=120

# 4-Pillar Security Gate: Beneficiary Account Whitelisting
# JSON-encoded array of authorized merchant receiving accounts for payment validation.
# Receipts paying unlisted or personal accounts fail closed with BENEFICIARY_MISMATCH (HTTP 422).
# Can also be managed dynamically in the Admin Dashboard (/admin).
RECEIPT_CBE_BENEFICIARIES=["1000123456789"]
RECEIPT_TELEBIRR_BENEFICIARIES=["0912345678"]
RECEIPT_ABYSSINIA_BENEFICIARIES=["1000123456789"]

# Evidence & Audit Trail Retention Policies
# RECEIPT_RETENTION_DAYS_RAW_PAYLOADS: Retention days for raw HTML/DOM snapshots in bank_verification_audits (default: 14)
# RECEIPT_RETENTION_DAYS_UNVERIFIED: Retention days for rejected or unverified receipt records (default: 30)
# RECEIPT_RETENTION_DAYS: Retention days for verified customer payment proof images in data/receipts/ (default: 90)
# RECEIPT_MAX_BYTES: Maximum allowable size in bytes for uploaded receipt images/PDFs (default: 5242880 = 5 MB)
RECEIPT_RETENTION_DAYS_RAW_PAYLOADS=14
RECEIPT_RETENTION_DAYS_UNVERIFIED=30
RECEIPT_RETENTION_DAYS=90
RECEIPT_MAX_BYTES=5242880

