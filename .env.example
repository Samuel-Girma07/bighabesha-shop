# ===================================================
# Bighabesha Shop Configuration
# ===================================================
# PRODUCTION BOOT REQUIREMENTS (fail-closed — the app refuses to start if any
# of these are missing/invalid when NODE_ENV=production):
#   - ADMIN_PASSWORD must be set (min 8 chars). There is NO default.
#   - WALLET_PAY_MODE must be explicitly "live" (mock auto-confirms payments).
#   - WALLET_PAY_API_KEY must be set when mode is live.
# ===================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Admin Telegram User IDs (comma-separated, exactly 2 for production)
ADMIN_IDS=123456789,987654321

# Master password for the web admin dashboard (/admin).
# REQUIRED in production. In development, leaving this empty disables the
# dashboard login entirely (fail-closed) instead of falling back to a default.
ADMIN_PASSWORD=

# Wallet Pay Settings
# Set to 'mock' for local development & testing, 'live' for production.
# Production + mock is a boot error by design.
WALLET_PAY_MODE=mock
WALLET_PAY_API_KEY=

# Database Configuration
DATABASE_PATH=./data/shop.db

# Server & Mini App Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
WEBAPP_URL=https://shop.bighabesha.com

# Reverse proxy / tunnel configuration.
# In production an EMPTY value auto-defaults to "loopback" (correct behind
# cloudflared/nginx-on-box) with a boot warning — this prevents every client
# from sharing the proxy's loopback IP, which would throttle all users
# collectively through one rate-limit bucket. Set explicitly to override
# ("1", "true", "false", "loopback", "10.0.0.0/8", ...). Empty = disabled (local dev).
TRUST_PROXY=

# Extra CORS origins allowed to call the API, comma-separated.
# WEBAPP_URL is always allowed automatically.
CORS_ORIGINS=

# Support Handle
SUPPORT_USERNAME=Vweah

# ---- v1.1.0 Advanced Integrations (all optional; features self-disable) ----
# In-app support bridge: forum-enabled Telegram group id (e.g. -1004567890123)
SUPPORT_GROUP_ID=
# Chapa gateway secret key (https://chapa.co) — enables Card/Telebirr/CBE Birr rail
CHAPA_SECRET_KEY=
# TON treasury wallet address — enables TON Connect non-custodial payments
TON_TREASURY_ADDRESS=
