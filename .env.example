# ===================================================
# Bighabesha Shop Configuration
# ===================================================
# PRODUCTION BOOT REQUIREMENTS (fail-closed — the app refuses to start if any
# of these are missing/invalid when NODE_ENV=production):
#   - ADMIN_PASSWORD must be set (min 8 chars). There is NO default.
#   - WALLET_PAY_MODE must be explicitly "live" (mock auto-confirms payments).
#   - WALLET_PAY_API_KEY must be set when mode is live.
# ===================================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Admin Telegram User IDs (comma-separated, exactly 2 for production)
ADMIN_IDS=123456789,987654321

# Master password for the web admin dashboard (/admin).
# REQUIRED in production. In development, leaving this empty disables the
# dashboard login entirely (fail-closed) instead of falling back to a default.
ADMIN_PASSWORD=

# ===================================================
# Active Payment Rails
# ===================================================
# The active customer payment rails in Bighabesha Shop are strictly:
#   - telebirr  : Telebirr Mobile Money (manual photo receipt upload & admin review)
#   - cbe       : Commercial Bank of Ethiopia (manual photo receipt upload & admin review)
#   - abyssinia : Bank of Abyssinia (manual photo receipt upload & admin review)
#
# Admin receiving account details (account numbers and account holder names)
# are managed dynamically in the Admin Dashboard (/admin) or the settings database table:
#   - telebirr_account, telebirr_name
#   - cbe_account, cbe_name
#   - abyssinia_account, abyssinia_name
#
# NOTE: Legacy rails (wallet_pay, chapa, ton_connect) are deprecated/discontinued.
# WALLET_PAY_MODE and WALLET_PAY_API_KEY below are maintained for backward-compatibility
# validation invariants.
# ===================================================

# Wallet Pay Settings
# Set to 'mock' for local development & testing, 'live' for production.
# Production + mock is a boot error by design.
WALLET_PAY_MODE=mock
WALLET_PAY_API_KEY=

# Database Configuration
DATABASE_PATH=./data/shop.db

# Server & Mini App Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
WEBAPP_URL=https://shop.bighabesha.com

# Reverse proxy / tunnel configuration.
# In production an EMPTY value auto-defaults to "loopback" (correct behind
# cloudflared/nginx-on-box) with a boot warning — this prevents every client
# from sharing the proxy's loopback IP, which would throttle all users
# collectively through one rate-limit bucket. Set explicitly to override
# ("1", "true", "false", "loopback", "10.0.0.0/8", ...). Empty = disabled (local dev).
TRUST_PROXY=

# Extra CORS origins allowed to call the API, comma-separated.
# WEBAPP_URL is always allowed automatically.
CORS_ORIGINS=

# Support Handle
SUPPORT_USERNAME=Vweah

# ---- v1.2.0 B2B Reseller Fulfillment (Telegram Premium) ----
# Delivery provider for automated Telegram Premium activations.
# Supported providers:
#   mock    - Dev/test only; auto-succeeds immediately with a synthetic transaction ID.
#             (Default for local development & automated test suites)
#   gramix  - Gramix B2B API (GRAMIX_API_URL defaults to https://api.gramix.io/v1)
#   istar   - iStar B2B API (ISTAR_API_URL defaults to https://istar.io/api/v2)
#   both    - Dual-provider cascading failover (Gramix primary -> iStar fallback; concurrent balance check)
#   cascade - Alias for 'both'
#   generic - Custom webhook endpoint; RESELLER_API_URL is REQUIRED (POST {fulfill|balance})
#
# Instructions for switching to live providers:
#   - Dual-provider cascading mode (recommended for production):
#       RESELLER_PROVIDER=both
#       GRAMIX_API_KEY=<your-gramix-api-key>
#       ISTAR_API_KEY=<your-istar-api-key>
#   - Single provider Gramix: set RESELLER_PROVIDER=gramix and supply GRAMIX_API_KEY (or RESELLER_API_KEY).
#   - Single provider iStar:  set RESELLER_PROVIDER=istar and supply ISTAR_API_KEY (or RESELLER_API_KEY).
#   - When RESELLER_PROVIDER is unset/empty, Premium orders fall back to the manual fulfillment queue
#     (orders wait in 'pending_fulfillment' for admin fulfillment by hand).
RESELLER_PROVIDER=mock
# Dedicated provider API keys — sent as Authorization: Bearer <key>. Never logged in cleartext.
GRAMIX_API_KEY=
ISTAR_API_KEY=
# Shared legacy API key (fallback for single-provider setups)
RESELLER_API_KEY=
# Provider base URL overrides (optional for gramix/istar, REQUIRED for generic)
GRAMIX_API_URL=
ISTAR_API_URL=
RESELLER_API_URL=
# When the provider float drops below this USDT amount, admins are alerted.
RESELLER_LOW_BALANCE_ALERT_USDT=50

# ---- Legacy / Deprecated Integrations (all optional; self-disabled) ----
# Active customer rails are telebirr, cbe, and abyssinia. The following are legacy integrations:
# In-app support bridge: forum-enabled Telegram group id (e.g. -1004567890123)
SUPPORT_GROUP_ID=
# Chapa gateway secret key (https://chapa.co) — legacy rail (discontinued)
CHAPA_SECRET_KEY=
# TON treasury wallet address — legacy non-custodial rail (discontinued)
TON_TREASURY_ADDRESS=
