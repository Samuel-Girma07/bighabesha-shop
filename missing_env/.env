# ==============================================================================
# Bighabesha Shop - Missing Environment Variables for Production
# ==============================================================================
# These are the environment variables NOT present in your cloud hosting dashboard
# (Render/Railway/Fly.io). You can upload or copy these into your environment.
# Note: Variables already configured (BOT_TOKEN, ADMIN_IDS, ADMIN_PASSWORD,
# B2_*, GRAMIX_API_KEY, ISTAR_API_KEY, NODE_ENV, NODE_VERSION, RESELLER_PROVIDER,
# WALLET_PAY_MODE, WEBAPP_URL) are excluded here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# Server listening port.
# If deploying on Render.com, Render routes HTTP traffic to port 10000.
PORT=10000

# Express reverse proxy IP header trust.
# In production behind Cloudflare/Render/Nginx, setting this to "loopback" (or "1")
# ensures client IP addresses are accurately recognized for rate limiting.
TRUST_PROXY=loopback

# Additional comma-separated CORS origins permitted to call API endpoints.
# (WEBAPP_URL is always permitted automatically).
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 2. Logging & System Operations
# ------------------------------------------------------------------------------
# Application log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# SQLite busy lock timeout in milliseconds (absorbs transient file locks).
SQLITE_BUSY_TIMEOUT=5000

# Optional persistent volume directory if using mounted disks (e.g. /var/data).
# If left unset, defaults to ./data (and Litestream continuously backs up to B2).
DATA_DIR=

# Optional B2 region override (automatically extracted from B2_ENDPOINT if empty).
B2_REGION=

# ------------------------------------------------------------------------------
# 3. Storefront, Support & Telegram Channel Gates
# ------------------------------------------------------------------------------
# Official customer support Telegram username (without @).
SUPPORT_USERNAME=Vweah

# Mandatory channel username that users must join before using the shop.
REQUIRED_CHANNEL_USERNAME=@bighabesha_softwares

# Invite link displayed to users who have not yet joined the mandatory channel.
REQUIRED_CHANNEL_LINK=https://t.me/bighabesha_softwares

# Enforce mandatory channel subscription (true | false).
FORCE_SUBSCRIBE=true

# ------------------------------------------------------------------------------
# 4. Telegram Premium Reseller Float & Alerts
# ------------------------------------------------------------------------------
# Alert admins on Telegram when provider float/balance drops below this USDT amount.
RESELLER_LOW_BALANCE_ALERT_USDT=50

# Optional provider API URL overrides (only needed if using custom proxy or endpoints):
# GRAMIX_API_URL=https://api.gramix.io/v1
# ISTAR_API_URL=https://istar.io/api/v2

# ------------------------------------------------------------------------------
# 5. Ethiopian Bank Receipt Verification Engine (v1.3.0)
# ------------------------------------------------------------------------------
# Enable automated external bank portal verification (1 = enabled, 0 = manual queue only).
RECEIPT_AUTO_VERIFY_ENABLED=1

# Commercial Bank of Ethiopia (CBE) verification portal port.
# CBE transaction verification portal operates on Port 100 by default.
RECEIPT_CBE_PORT=100

# Ethio Telecom Telebirr residential egress proxy.
# Telebirr portal geoblocks foreign IPs (HTTP 403) outside Ethiopia.
# Provide an Ethiopian HTTP or SOCKS5 proxy if hosting outside Ethiopia.
# Format: http://user:pass@host:port or socks5://user:pass@host:port
# Can also be configured dynamically in the Admin Dashboard Settings.
TELEBIRR_PROXY_URL=
ETHIOPIA_PROXY_URL=

# Upstream bank portal circuit breaker + 4-pillar recency window are tuned from the Admin
# Dashboard (settings table), NOT from environment variables. The authoritative keys are:
#   receipt_circuit_breaker_threshold    (integer 2-20)    default 5
#   receipt_circuit_breaker_cooldown_sec (integer 10-600)  default 60
#   receipt_recency_before_mins          (integer 5-1440)  default 120
#   receipt_recency_after_mins           (integer 5-1440)  default 120
# The legacy RECEIPT_CIRCUIT_BREAKER_* and RECEIPT_RECENCY_* variables were never read by the
# application and are intentionally absent so they cannot be trusted to have any effect.

# Receipt storage retention policy (days) and maximum file size (5MB).
RECEIPT_RETENTION_DAYS=90
RECEIPT_MAX_BYTES=5242880
